---
import { Icon } from "astro-icon/components";
import { url } from "@utils/url-utils";
import MainGridLayout from "@layouts/MainGridLayout.astro";

// canonical="" : this page is served for every unknown address and is marked
// noindex below, so it must not claim a canonical URL of its own (/404/ is not
// a real page).
---

<MainGridLayout title="页面不存在" description="这个地址下没有内容，可能是文章链接改过了，也可能是地址抄错了一两个字母。" canonical="">
    <Fragment slot="head">
        <meta name="robots" content="noindex" />
    </Fragment>

    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-10 relative w-full">
            <div class="flex flex-col items-center text-center">
                <div class="text-6xl md:text-7xl font-bold text-[var(--primary)] opacity-90 leading-none">
                    404
                </div>
                <div class="mt-5 text-xl font-semibold">这里没有东西</div>
                <p class="mt-3 opacity-75 max-w-md leading-relaxed">
                    你打开的地址在这站上不存在。
                    <br />
                    可能是我后来改了文章的链接，也可能是地址少抄了一个字母。
                </p>
                <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
                    <a href={url("/")}
                       class="btn-regular rounded-lg h-12 px-7 gap-2 font-bold active:scale-95 text-[var(--btn-content)]">
                        <Icon name="material-symbols:home-outline-rounded" class="text-[1.5rem]" />
                        回到首页
                    </a>
                    <a href={url("/archive/")}
                       class="btn-plain scale-animation rounded-lg h-12 px-5 font-bold active:scale-95">
                        <Icon name="material-symbols:notes-rounded" class="text-[1.5rem] mr-1" />
                        全部文章
                    </a>
                </div>
                <p class="mt-9 text-sm opacity-50 leading-relaxed">
                    如果你是从别人写的教程里点进来的，告诉我出处，我把旧地址重定向到新的那一篇。
                </p>
            </div>
        </div>
    </div>
</MainGridLayout>
