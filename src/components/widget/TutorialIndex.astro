---
import { Icon } from "astro-icon/components";
import { getTutorialGroups, getTutorialUrl } from "../../utils/tutorial-utils";
import WidgetLayout from "./WidgetLayout.astro";

/**
 * 侧边栏「索引」：只在基础教程那一部分（/tutorials/ 系列页面）出现。
 *
 * 数据来自 src/content/tutorials/ 这个独立集合，不是首页那份分类/标签，
 * 也不是手写死数据 —— 你往目录里丢 .md，这里自动多一行。
 */

interface Props {
	class?: string;
	style?: string;
	/** 是否把分组标题做成 /tutorials/#<锚点> 的跳转 */
	anchors?: boolean;
}

const { anchors = true } = Astro.props;
const className = Astro.props.class;
const style = Astro.props.style;

const groups = await getTutorialGroups();

const anchorOf = (name: string): string =>
	name === "基础依赖" ? "base" : name === "安装教程" ? "install" : name === "使用教程" ? "usage" : "more";
---

<WidgetLayout name="索引" id="tutorial-index" class={className} style={style}>
    <div class="flex flex-col gap-1 pb-1">
        {
            groups.map((group) => (
                <div class="mb-1">
                    <div class="flex items-center gap-1.5 px-2 py-1.5">
                        {anchors ? (
                            <a
                                href={`/tutorials/#${anchorOf(group.name)}`}
                                class="text-[0.72rem] font-bold tracking-wide uppercase text-50 transition hover:text-[var(--primary)]"
                            >
                                {group.name}
                            </a>
                        ) : (
                            <span class="text-[0.72rem] font-bold tracking-wide uppercase text-50">
                                {group.name}
                            </span>
                        )}
                        <span class="text-[0.7rem] text-50 opacity-60">{group.items.length}</span>
                    </div>
                    {
                        group.items.map((item) => (
                            <a
                                href={getTutorialUrl(item.slug)}
                                class="transition rounded-lg flex items-start gap-2 px-2 py-1.5 hover:bg-[var(--btn-plain-bg-hover)] group"
                                aria-label={`打开教程：${item.data.title}`}
                            >
                                <Icon
                                    name="material-symbols:chevron-right-rounded"
                                    class="text-[1.05rem] shrink-0 mt-[0.15rem] text-50 transition group-hover:text-[var(--primary)]"
                                />
                                <span class="min-w-0">
                                    <span class="block text-[0.875rem] leading-snug text-neutral-700 dark:text-neutral-300 transition group-hover:text-[var(--primary)]">
                                        {item.data.title}
                                    </span>
                                    {item.data.short && (
                                        <span class="block font-mono text-[0.68rem] text-50 opacity-70 mt-0.5">
                                            /s/{item.data.short}
                                        </span>
                                    )}
                                </span>
                            </a>
                        ))
                    }
                </div>
            ))
        }
        {
            groups.length === 0 && (
                <p class="text-50 text-[0.78rem] px-2 py-2 leading-relaxed">
                    还没有教程。把 .md 放进 src/content/tutorials/ 就会出现在这里。
                </p>
            )
        }
        <a
            href="/tutorials/"
            class="transition mt-1 rounded-lg flex items-center justify-between px-2 py-2 hover:bg-[var(--btn-plain-bg-hover)] group"
        >
            <span class="text-[0.8rem] font-medium text-[var(--primary)]">打开完整目录</span>
            <Icon
                name="material-symbols:arrow-forward-rounded"
                class="text-[1rem] text-[var(--primary)] transition group-hover:translate-x-0.5"
            />
        </a>
    </div>
</WidgetLayout>
