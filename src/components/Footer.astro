---
import { Icon } from "astro-icon/components";
import { profileConfig, siteConfig } from "../config";
import { url } from "../utils/url-utils";

const currentYear = new Date().getFullYear();

// 建站日期来自 src/config.ts 的 siteConfig.startDate（'YYYY-MM-DD'，本地时区）。
// 留空则不显示「本站已运行」这一行。
const startDate = siteConfig.startDate ?? "";

const pad = (value: number): string => String(value).padStart(2, "0");

// 构建期先算一遍，作为无 JavaScript 时的兜底文字；页面加载后由脚本接管、每秒刷新。
const diffParts = (raw: string) => {
	const match = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(raw.trim());
	if (!match) return null;
	const start = new Date(
		Number(match[1]),
		Number(match[2]) - 1,
		Number(match[3]),
		0,
		0,
		0,
		0,
	);
	if (Number.isNaN(start.getTime())) return null;

	const now = new Date();
	let years = now.getFullYear() - start.getFullYear();
	const anchor = new Date(start.getTime());
	anchor.setFullYear(start.getFullYear() + years);
	// 2 月 29 日建站在平年会被 JS 溢出到 3 月 1 日，先归位到 2 月 28 日。
	if (anchor.getMonth() !== start.getMonth()) anchor.setDate(0);
	if (anchor.getTime() > now.getTime()) {
		years -= 1;
		anchor.setFullYear(start.getFullYear() + years);
	}
	let rest = now.getTime() - anchor.getTime();
	if (rest < 0) rest = 0;
	const totalSeconds = Math.floor(rest / 1000);
	return {
		years,
		days: Math.floor(totalSeconds / 86400),
		hours: Math.floor(totalSeconds / 3600) % 24,
		minutes: Math.floor(totalSeconds / 60) % 60,
		seconds: totalSeconds % 60,
	};
};

const initialParts = startDate ? diffParts(startDate) : null;
// 数字用主色 + 中等字重，单位保持页脚的浅灰；服务端先渲染一遍，JavaScript 接管后每秒只改数字。
// 这里必须是单行 HTML：换行会被折进中间的空白，导致「133 天」被拆到两行。
const num = (key: string, value: number | string): string =>
	`<span data-rt="${key}" class="text-[var(--primary)] font-medium">${value}</span>`;

const initialHtml = initialParts
	? `${num("years", initialParts.years)} 年 ${num("days", initialParts.days)} 天 ${num("hours", pad(initialParts.hours))} 时 ${num("minutes", pad(initialParts.minutes))} 分 ${num("seconds", pad(initialParts.seconds))} 秒`
	: "日期待配置";
---

<!--<div class="border-t border-[var(&#45;&#45;primary)] mx-16 border-dashed py-8 max-w-[var(&#45;&#45;page-width)] flex flex-col items-center justify-center px-6">-->
<div class="transition border-t border-black/10 dark:border-white/15 my-10 border-dashed mx-32"></div>
<!--<div class="transition bg-[oklch(92%_0.01_var(&#45;&#45;hue))] dark:bg-black rounded-2xl py-8 mt-4 mb-8 flex flex-col items-center justify-center px-6">-->
<div class="transition border-dashed border-[oklch(85%_0.01_var(--hue))] dark:border-white/15 rounded-2xl mb-12 flex flex-col items-center justify-center px-6">
    {
        startDate && (
            <div class="transition flex flex-wrap items-center justify-center gap-x-1.5 text-50 text-sm text-center mb-2">
                <Icon
                    name="fa6-solid:hourglass-half"
                    class="text-[var(--primary)] text-[0.95em] opacity-80"
                />
                <span>本站已运行</span>
                <span
                    data-site-runtime
                    data-start-date={startDate}
                    class="tabular-nums"
                    set:html={initialHtml}
                ></span>
            </div>
        )
    }
    <div class="transition text-50 text-sm text-center">
        &copy; <span id="copyright-year">{currentYear}</span> {profileConfig.name}. All Rights Reserved. /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('rss.xml')}>RSS</a> /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href={url('sitemap-index.xml')}>Sitemap</a><br>
        Powered by
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://astro.build">Astro</a> &
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://github.com/saicaca/fuwari">Fuwari</a> /
        <a class="transition link text-[var(--primary)] font-medium" target="_blank" href="https://rareui.com">Rare UI</a>
    </div>
</div>

<script is:inline data-astro-rerun>
	(function () {
		// swup 翻页会重跑本脚本：先清掉上一轮的定时器，避免计数叠加与句柄泄漏。
		if (window.__siteRuntimeTimer) {
			clearInterval(window.__siteRuntimeTimer);
			window.__siteRuntimeTimer = null;
		}

		// 桌面/移动各渲染一个 Footer，两个都要更新。
		const nodes = document.querySelectorAll("[data-site-runtime]");
		if (nodes.length === 0) return;

		// 按「本地时区 00:00:00」解析建站日，避免 new Date("YYYY-MM-DD") 被当成 UTC 而错开 8 小时。
		const parseStart = function (raw) {
			const match = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec((raw || "").trim());
			if (!match) return null;
			const date = new Date(
				Number(match[1]),
				Number(match[2]) - 1,
				Number(match[3]),
				0,
				0,
				0,
				0,
			);
			return Number.isNaN(date.getTime()) ? null : date;
		};

		const start = parseStart(nodes[0].getAttribute("data-start-date"));
		if (!start) {
			for (const node of nodes) node.textContent = "日期待配置";
			return;
		}

		const pad = function (value) {
			return String(value).padStart(2, "0");
		};

		// 用日历年纪，而不是 365.2425 天的近似，闰年才不会算错天数。
		const diffParts = function (now) {
			let years = now.getFullYear() - start.getFullYear();
			const anchor = new Date(start.getTime());
			anchor.setFullYear(start.getFullYear() + years);
			if (anchor.getMonth() !== start.getMonth()) anchor.setDate(0);
			if (anchor.getTime() > now.getTime()) {
				years -= 1;
				anchor.setFullYear(start.getFullYear() + years);
			}
			let rest = now.getTime() - anchor.getTime();
			if (rest < 0) rest = 0;
			const totalSeconds = Math.floor(rest / 1000);
			return {
				years: years,
				days: Math.floor(totalSeconds / 86400),
				hours: Math.floor(totalSeconds / 3600) % 24,
				minutes: Math.floor(totalSeconds / 60) % 60,
				seconds: totalSeconds % 60,
			};
		};

		// 只改数字节点的文本，不拼 HTML，既保持主色高亮，也没有 innerHTML 注入风险。
		const fields = ["years", "days", "hours", "minutes", "seconds"];
		const render = function () {
			const parts = diffParts(new Date());
			for (const node of nodes) {
				for (const key of fields) {
					const target = node.querySelector('[data-rt="' + key + '"]');
					if (!target) continue;
					const next =
						key === "years" || key === "days"
							? String(parts[key])
							: pad(parts[key]);
					if (target.textContent !== next) target.textContent = next;
				}
			}
		};

		render();
		window.__siteRuntimeTimer = setInterval(render, 1000);
	})();
</script>
